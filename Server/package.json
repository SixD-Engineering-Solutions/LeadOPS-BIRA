{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "npx prisma generate",
    "db:push": "set NODE_EXTRA_CA_CERTS=./certs/aiven-ca.pem && npx prisma db push",
    "db:migrate": "set NODE_EXTRA_CA_CERTS=./certs/aiven-ca.pem && npx prisma migrate dev",
    "db:migrate:deploy": "set NODE_EXTRA_CA_CERTS=./certs/aiven-ca.pem && npx prisma migrate deploy",
    "db:migrate:status": "set NODE_EXTRA_CA_CERTS=./certs/aiven-ca.pem && npx prisma migrate status",
    "db:seed": "npx ts-node prisma/seed.ts",
    "db:import-tracker": "npx ts-node prisma/importTracker.ts",
    "db:studio": "set NODE_EXTRA_CA_CERTS=./certs/aiven-ca.pem && npx prisma studio",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "prisma@7.8.0": true
  }
}
