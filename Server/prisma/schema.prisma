generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users / employees ──────────────────────────────────────────────────────
// Unified table: these are the internal employees (who leads are assigned to /
// created by) AND the accounts that log in. `password_hash` is nullable so an
// admin can add an employee before they've set up login.
model User {
  id           String   @id @default(cuid())
  userName     String?  @map("user_name")
  email        String   @unique
  phoneNumber  String?  @map("phone_number")
  role         String   @default("employee")
  department   String?
  passwordHash String?  @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignedLeads      Lead[] @relation("AssignedTo")
  assignedByMeLeads  Lead[] @relation("AssignedBy")
  createdLeads       Lead[] @relation("CreatedBy")
  notifications      Notification[]

  @@map("users")
}

// Per-user inbox entries, pushed in real time over SSE when created (see
// services/notify.ts) and also listed on demand via GET /notifications.
model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  leadId    String?  @map("lead_id")
  lead      Lead?    @relation(fields: [leadId], references: [id])
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}

model OtpToken {
  id        String   @id @default(cuid())
  email     String
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("otp_tokens")
}

// ─── Location → Plants → Contacts ───────────────────────────────────────────
model Location {
  id        String   @id @default(cuid())
  city      String
  state     String?
  country   String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plants Plant[]

  @@map("locations")
}

model Plant {
  id          String   @id @default(cuid())
  plantName   String    @map("plant_name")
  companyName String?   @map("company_name")
  locationId  String?   @map("location_id")
  location    Location? @relation(fields: [locationId], references: [id])
  plantCode   String?  @map("plant_code")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  contacts Contact[]
  leads    Lead[]

  @@index([locationId])
  @@map("plants")
}

model Contact {
  id                  String   @id @default(cuid())
  plantId             String   @map("plant_id")
  plant               Plant    @relation(fields: [plantId], references: [id])
  contactPersonName   String   @map("contact_person_name")
  designation         String?
  contactPersonNumber String?  @map("contact_person_number")
  alternateNumber     String?  @map("alternate_number")
  mailId              String?  @map("mail_id")
  isPrimaryContact    Boolean  @default(false) @map("is_primary_contact")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  leads Lead[]

  @@index([plantId])
  @@map("contacts")
}

// ─── Lookup / reference tables ──────────────────────────────────────────────
model Vertical {
  id           String   @id @default(cuid())
  verticalName String   @map("vertical_name")
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  leads Lead[]

  @@map("verticals")
}

model Sector {
  id          String   @id @default(cuid())
  sectorName  String   @map("sector_name")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  leads Lead[]

  @@map("sectors")
}

model LeadStatus {
  id             String   @id @default(cuid())
  statusName     String   @map("status_name")
  statusCategory String?  @map("status_category")
  displayOrder   Int      @default(0) @map("display_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  leads Lead[]

  @@map("lead_statuses")
}

// ─── Leads (main table) ─────────────────────────────────────────────────────
model Lead {
  id               String      @id @default(cuid())
  plantId          String      @map("plant_id")
  plant            Plant       @relation(fields: [plantId], references: [id])
  verticalId       String?     @map("vertical_id")
  vertical         Vertical?   @relation(fields: [verticalId], references: [id])
  sectorId         String?     @map("sector_id")
  sector           Sector?     @relation(fields: [sectorId], references: [id])
  contactId        String?     @map("contact_id")
  contact          Contact?    @relation(fields: [contactId], references: [id])
  assignedToUserId String?     @map("assigned_to_user_id")
  assignedToUser   User?       @relation("AssignedTo", fields: [assignedToUserId], references: [id])
  assignedByUserId String?     @map("assigned_by_user_id")
  assignedByUser   User?       @relation("AssignedBy", fields: [assignedByUserId], references: [id])
  statusId         String?     @map("status_id")
  status           LeadStatus? @relation(fields: [statusId], references: [id])
  remark           String?
  createdByUserId  String      @map("created_by_user_id")
  createdByUser    User        @relation("CreatedBy", fields: [createdByUserId], references: [id])
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  deletedAt        DateTime?   @map("deleted_at")
  notifications    Notification[]

  @@index([plantId])
  @@index([assignedToUserId])
  @@index([statusId])
  @@index([deletedAt])
  @@map("leads")
}
