generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users / employees ──────────────────────────────────────────────────────
// Unified table: these are the internal employees (who leads are assigned to /
// created by) AND the accounts that log in. `password_hash` is nullable so an
// admin can add an employee before they've set up login.
model User {
  id           String   @id @default(cuid())
  userName     String?  @map("user_name")
  email        String   @unique
  phoneNumber  String?  @map("phone_number")
  role         String   @default("employee")
  department   String?
  passwordHash String?  @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignedLeads      Lead[] @relation("AssignedTo")
  assignedByMeLeads  Lead[] @relation("AssignedBy")
  createdLeads       Lead[] @relation("CreatedBy")
  notifications      Notification[]
  assignedTasks      Task[] @relation("TaskAssignedTo")
  assignedByMeTasks  Task[] @relation("TaskAssignedBy")
  activities         Activity[]
  createdProposals   Proposal[] @relation("ProposalCreatedBy")
  responsibleProjects Project[] @relation("ProjectResponsible")
  createdProjects     Project[] @relation("ProjectCreatedBy")
  documents           Document[]
  createdInvoices     Invoice[]
  recordedPayments    Payment[]
  createdEmpanelments Empanelment[]
  createdTenders      Tender[]
  createdEvents       Event[]

  @@map("users")
}

// Per-user inbox entries, pushed in real time over SSE when created (see
// services/notify.ts) and also listed on demand via GET /notifications.
model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  leadId    String?  @map("lead_id")
  lead      Lead?    @relation(fields: [leadId], references: [id])
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}

model OtpToken {
  id        String   @id @default(cuid())
  email     String
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("otp_tokens")
}

// ─── Clients ─────────────────────────────────────────────────────────────
model ClientCategory {
  id           String   @id @default(cuid())
  categoryName String   @map("category_name")
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  clients Client[]

  @@map("client_categories")
}

model Client {
  id           String          @id @default(cuid())
  clientName   String          @map("client_name")
  industryType String?         @map("industry_type")
  website      String?
  linkedIn     String?         @map("linked_in")
  categoryId   String?         @map("category_id")
  category     ClientCategory? @relation(fields: [categoryId], references: [id])
  country      String?
  region       String?
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  plants       Plant[]
  empanelments Empanelment[]
  tenders      Tender[]

  @@index([categoryId])
  @@map("clients")
}

// ─── Location → Plants → Contacts ───────────────────────────────────────────
model Location {
  id        String   @id @default(cuid())
  city      String
  state     String?
  country   String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plants   Plant[]
  projects Project[]

  @@map("locations")
}

model Plant {
  id          String   @id @default(cuid())
  plantName   String    @map("plant_name")
  companyName String?   @map("company_name")
  clientId    String?   @map("client_id")
  client      Client?   @relation(fields: [clientId], references: [id])
  locationId  String?   @map("location_id")
  location    Location? @relation(fields: [locationId], references: [id])
  plantCode   String?  @map("plant_code")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  contacts Contact[]
  leads    Lead[]

  @@index([locationId])
  @@index([clientId])
  @@map("plants")
}

model Contact {
  id                  String   @id @default(cuid())
  plantId             String   @map("plant_id")
  plant               Plant    @relation(fields: [plantId], references: [id])
  contactPersonName   String   @map("contact_person_name")
  designation         String?
  contactPersonNumber String?  @map("contact_person_number")
  alternateNumber     String?  @map("alternate_number")
  mailId              String?  @map("mail_id")
  isPrimaryContact    Boolean  @default(false) @map("is_primary_contact")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  leads Lead[]

  @@index([plantId])
  @@map("contacts")
}

// ─── Lookup / reference tables ──────────────────────────────────────────────
model Vertical {
  id           String   @id @default(cuid())
  verticalName String   @map("vertical_name")
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  leads Lead[]

  @@map("verticals")
}

model Sector {
  id          String   @id @default(cuid())
  sectorName  String   @map("sector_name")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  leads Lead[]

  @@map("sectors")
}

model LeadSource {
  id          String   @id @default(cuid())
  sourceName  String   @map("source_name")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  leads Lead[]

  @@map("lead_sources")
}

model ServiceType {
  id              String   @id @default(cuid())
  serviceTypeName String   @map("service_type_name")
  description     String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  leads        Lead[]
  empanelments Empanelment[]

  @@map("service_types")
}

model LeadStatus {
  id             String   @id @default(cuid())
  statusName     String   @map("status_name")
  statusCategory String?  @map("status_category")
  displayOrder   Int      @default(0) @map("display_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  leads Lead[]

  @@map("lead_statuses")
}

// ─── Leads (main table) ─────────────────────────────────────────────────────
model Lead {
  id               String      @id @default(cuid())
  plantId          String      @map("plant_id")
  plant            Plant       @relation(fields: [plantId], references: [id])
  verticalId       String?     @map("vertical_id")
  vertical         Vertical?   @relation(fields: [verticalId], references: [id])
  sectorId         String?     @map("sector_id")
  sector           Sector?     @relation(fields: [sectorId], references: [id])
  sourceId         String?     @map("source_id")
  source           LeadSource? @relation(fields: [sourceId], references: [id])
  serviceTypeId    String?     @map("service_type_id")
  serviceType      ServiceType? @relation(fields: [serviceTypeId], references: [id])
  eventId          String?     @map("event_id")
  event            Event?      @relation(fields: [eventId], references: [id])
  contactId        String?     @map("contact_id")
  contact          Contact?    @relation(fields: [contactId], references: [id])
  assignedToUserId String?     @map("assigned_to_user_id")
  assignedToUser   User?       @relation("AssignedTo", fields: [assignedToUserId], references: [id])
  assignedByUserId String?     @map("assigned_by_user_id")
  assignedByUser   User?       @relation("AssignedBy", fields: [assignedByUserId], references: [id])
  statusId         String?     @map("status_id")
  status           LeadStatus? @relation(fields: [statusId], references: [id])
  remark           String?
  createdByUserId  String      @map("created_by_user_id")
  createdByUser    User        @relation("CreatedBy", fields: [createdByUserId], references: [id])
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  deletedAt        DateTime?   @map("deleted_at")
  notifications    Notification[]
  activities       Activity[]
  proposals        Proposal[]
  projects         Project[]
  documents        Document[]

  @@index([plantId])
  @@index([assignedToUserId])
  @@index([statusId])
  @@index([deletedAt])
  @@map("leads")
}

// ─── Tasks ───────────────────────────────────────────────────────────────
// A to-do an admin hands to an employee, independent of any lead. Deadline is
// required — that's the point of a task vs. a lead's freeform remark.
model Task {
  id               String    @id @default(cuid())
  title            String
  description      String?
  deadline         DateTime
  status           String    @default("Pending")
  assignedToUserId String    @map("assigned_to_user_id")
  assignedToUser   User      @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id])
  assignedByUserId String    @map("assigned_by_user_id")
  assignedByUser   User      @relation("TaskAssignedBy", fields: [assignedByUserId], references: [id])
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  @@index([assignedToUserId])
  @@index([deletedAt])
  @@map("tasks")
}

// ─── Activities ──────────────────────────────────────────────────────────
// A logged call/visit/meeting/mail against a lead, with an optional next
// action date — this is what drives the follow-up/reminder dashboard.
model Activity {
  id             String    @id @default(cuid())
  leadId         String    @map("lead_id")
  lead           Lead      @relation(fields: [leadId], references: [id])
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id])
  activityType   String    @map("activity_type")
  activityDate   DateTime  @map("activity_date")
  notes          String?
  nextActionDate DateTime? @map("next_action_date")
  dueNotifiedAt  DateTime? @map("due_notified_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([leadId])
  @@index([nextActionDate])
  @@map("activities")
}

// ─── Proposals ───────────────────────────────────────────────────────────
// A quoted opportunity raised against a lead — proposalNumber is assigned by
// the server (sequential), everything else is entered by whoever raises it.
model Proposal {
  id                String    @id @default(cuid())
  proposalNumber    String    @unique @map("proposal_number")
  leadId            String    @map("lead_id")
  lead              Lead      @relation(fields: [leadId], references: [id])
  projectName       String?   @map("project_name")
  value             Float?
  submissionDate    DateTime? @map("submission_date")
  status            String    @default("Draft")
  probabilityPct    Int?      @map("probability_pct")
  expectedOrderDate DateTime? @map("expected_order_date")
  createdByUserId   String    @map("created_by_user_id")
  createdByUser     User      @relation("ProposalCreatedBy", fields: [createdByUserId], references: [id])
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  project Project?

  @@index([leadId])
  @@index([status])
  @@index([deletedAt])
  @@map("proposals")
}

// ─── Projects / Work Orders ──────────────────────────────────────────────
// Post-order execution tracking — either auto-created when a Proposal is
// marked "Won" (see proposals.ts), or raised directly for work that didn't
// go through a proposal.
model Project {
  id                String    @id @default(cuid())
  workOrderNo       String    @unique @map("work_order_no")
  proposalId        String?   @unique @map("proposal_id")
  proposal          Proposal? @relation(fields: [proposalId], references: [id])
  leadId            String    @map("lead_id")
  lead              Lead      @relation(fields: [leadId], references: [id])
  projectName       String
  locationId        String?   @map("location_id")
  location          Location? @relation(fields: [locationId], references: [id])
  startDate         DateTime? @map("start_date")
  completionDate    DateTime? @map("completion_date")
  responsibleUserId String?   @map("responsible_user_id")
  responsibleUser   User?     @relation("ProjectResponsible", fields: [responsibleUserId], references: [id])
  status            String    @default("Not Started")
  billingStage      String    @default("Not Started") @map("billing_stage")
  createdByUserId   String    @map("created_by_user_id")
  createdByUser     User      @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id])
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  invoices Invoice[]

  @@index([leadId])
  @@index([status])
  @@index([deletedAt])
  @@map("projects")
}

// ─── Documents ───────────────────────────────────────────────────────────
// PDF files uploaded against a lead, stored on local disk under
// UPLOAD_DIR (see routes/documents.ts). `storedFileName` is a bcrypt-derived
// name on disk — never the original filename — so it can't be guessed from
// the download URL; `fileName` is the original name shown to users.
model Document {
  id               String    @id @default(cuid())
  leadId           String    @map("lead_id")
  lead             Lead      @relation(fields: [leadId], references: [id])
  fileName         String    @map("file_name")
  storedFileName   String    @unique @map("stored_file_name")
  fileSize         Int       @map("file_size")
  uploadedByUserId String    @map("uploaded_by_user_id")
  uploadedByUser   User      @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")

  @@index([leadId])
  @@map("documents")
}

// ─── Invoices / Payments ─────────────────────────────────────────────────
// Invoice status is recomputed server-side from its payments (see
// routes/invoices.ts) rather than being hand-set, so it can't drift out of
// sync with what's actually been paid.
model Invoice {
  id              String    @id @default(cuid())
  invoiceNumber   String    @unique @map("invoice_number")
  projectId       String    @map("project_id")
  project         Project   @relation(fields: [projectId], references: [id])
  amount          Float
  invoiceDate     DateTime? @map("invoice_date")
  dueDate         DateTime? @map("due_date")
  status          String    @default("Draft")
  createdByUserId String    @map("created_by_user_id")
  createdByUser   User      @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  payments Payment[]

  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
  @@map("invoices")
}

model Payment {
  id               String   @id @default(cuid())
  invoiceId        String   @map("invoice_id")
  invoice          Invoice  @relation(fields: [invoiceId], references: [id])
  amountReceived   Float    @map("amount_received")
  paymentDate      DateTime @map("payment_date")
  notes            String?
  recordedByUserId String   @map("recorded_by_user_id")
  recordedByUser   User     @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("payments")
}

// ─── Empanelment tracking ─────────────────────────────────────────────────
// Being on a client's approved-vendor list for a given service category.
model Empanelment {
  id              String    @id @default(cuid())
  clientId        String    @map("client_id")
  client          Client    @relation(fields: [clientId], references: [id])
  serviceTypeId   String?   @map("service_type_id")
  serviceType     ServiceType? @relation(fields: [serviceTypeId], references: [id])
  status          String    @default("Applied")
  renewalDate     DateTime? @map("renewal_date")
  createdByUserId String    @map("created_by_user_id")
  createdByUser   User      @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@index([clientId])
  @@index([deletedAt])
  @@map("empanelments")
}

// ─── Tender tracking ─────────────────────────────────────────────────────
// tenderNo is entered manually — it's issued by the tendering authority, not
// generated by this system (unlike proposalNumber/workOrderNo/invoiceNumber).
model Tender {
  id              String    @id @default(cuid())
  tenderNo        String    @map("tender_no")
  clientId        String    @map("client_id")
  client          Client    @relation(fields: [clientId], references: [id])
  submissionDate  DateTime? @map("submission_date")
  value           Float?
  status          String    @default("Identified")
  createdByUserId String    @map("created_by_user_id")
  createdByUser   User      @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@index([clientId])
  @@index([deletedAt])
  @@map("tenders")
}

// ─── Expo / visit tagging ────────────────────────────────────────────────
// A specific trade-show or site-visit instance that leads can be tagged to —
// more granular than LeadSource ("Expo" as a category), so "leads generated"
// can be counted per actual event.
model Event {
  id              String   @id @default(cuid())
  eventName       String   @map("event_name")
  eventType       String   @default("Expo")
  eventDate       DateTime? @map("event_date")
  createdByUserId String   @map("created_by_user_id")
  createdByUser   User     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now()) @map("created_at")

  leads Lead[]

  @@map("events")
}
